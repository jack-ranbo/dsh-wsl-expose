{
  "name": "dsh-wsl-expose",
  "description": [
	  "en":"Expose the DeepSeek Harness Web GUI to the public internet from WSL2 over IPv6 or IPv4 through a reverse proxy (Lucky). One /wan command sets up the socat loopback relay, Windows portproxy, firewall rule, IPv6 detection, and the trusted-host fence."
  ,"zh": "从 WSL2 走 IPv6/IPv4 经反向代理（Lucky）把 DSH Web GUI 暴露到公网：/wan up 一键建立 socat 中继、Windows portproxy、防火墙与 trusted-host 白名单，域名与端口持久化配置。"],
  "version": "1.5.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "owner": "jack-ranbo",
  "url": "https://github.com/jack-ranbo/dsh-wsl-expose",
  "category": "network",
  "npm": "dsh-wsl-expose",
  "install": "dsh plugin --profile web add dsh-wsl-expose",
  "added": "2026-08-18",
  "license": "MIT",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "wsl",
    "wsl2",
    "ipv6",
    "reverse-proxy",
    "lucky",
    "portproxy",
    "expose",
    "tunnel",
    "public-access"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jack-ranbo/dsh-wsl-expose.git"
  },
  "homepage": "https://github.com/jack-ranbo/dsh-wsl-expose",
  "dependencies": {
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
